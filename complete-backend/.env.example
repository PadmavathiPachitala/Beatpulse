# BeatPulse Backend Environment Template
PORT=4000
# MongoDB Connection String (accepts either MONGODB_URI or MONGO_URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/spotify_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/spotify_db?retryWrites=true&w=majority
JWT_SECRET=replace_with_secure_production_jwt_secret
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint
ARTIST_INVITE_KEY=BEATPULSE_ARTIST
ADMIN_KEY=BEATPULSE_ADMIN
FRONTEND_ORIGIN=http://localhost:3000
# External Music Provider: Audius Open Protocol (100% Free, no API key or paid subscription required)
# Default app name: BeatPulse_SpotifyClone
